---
import '../styles/global.css'
import Master from '../layouts/Master.astro'
import FriendCard from '../components/FriendCard.astro';
const allFriends = await Astro.glob('../friends/*.md');
---
<style>
    div{
        display:flex;
        flex-wrap:wrap;
        gap:1.25rem;
        justify-content:center;
    }
    p{
        margin-bottom:2rem;
    }
</style>
<Master title="Friends">
    <p>Below are some of the people I like and/or work with. Go check them out!
        If we're friends and you want to be added here, send me your website & a picture you want featured
        and we can make it happen. ^-^
    </p>
    <div>
        {allFriends.map((friend) => <FriendCard frontmatter={friend.frontmatter} textbody={friend}/>)}
    </div>
</Master>