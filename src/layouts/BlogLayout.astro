---
import '/src/styles/global.css'
import Master from './Master.astro'
const {frontmatter} = Astro.props;

---
<style>
    div{
        display:flex;
        justify-content:center;
        gap:4rem;
    }
    .postbody{
        display:block;
        justify-content:left;
        margin:3rem;
    }
    
    @media screen and (max-width:635px){
        p{
            justify-self:center;
            justify-content:center;
        }
        h1{
            display:none;
        }
    }

</style>
<style is:global>
    body{
        max-width:150ch;
        margin:1rem auto;
        margin-bottom: 8rem;
    }
    p{
        margin:1rem auto;
        padding:0%
    }
    h2{
        margin:1rem auto;
        text-align:left;
    }
    img{
        max-width:500px;
    }
    li{
        margin:1rem auto;
        font-size:15px;
    }
    @media screen and (max-width:635px){
        body{
            max-width:none;
        }
        p{
            max-width:100%;
            font-size:14px;
            padding:0%;
        }
        h2{
            font-size:16px;
        }
        li{
            font-size:14px;
            padding:0%;
        }
        
    }
    
</style>
<Master title={frontmatter.title}>
    <div>
    <h2 class="postheader">Published: {frontmatter.crdate.toString().slice(0,10)}</h2>
    
    </div>
    <div>
        <h3 class="postheader">By {frontmatter.author}</h3>
    </div>
    <div class="postbody">
    <slot/>
    </div>
    
</Master>