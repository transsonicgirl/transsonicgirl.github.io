---
import '/src/styles/global.css'
import Master from './Master.astro'
const {frontmatter} = Astro.props;

---
<style>
    div{
        display:flex;
        justify-content:center;
        gap:4rem;
    }
    .postbody{
        display:block;
        justify-content:left;
        margin:3rem;
    }
    

</style>
<style is:global>
    body{
        max-width:150ch;
        margin:1rem auto;
        margin-bottom: 8rem;
    }
    p{
        margin:1rem auto;
    }
    h2{
        margin:1rem auto;
    }
    img{
        max-width:500px;
    }
    
</style>
<Master title={frontmatter.title}>
    <div>
    <h2>Published: {frontmatter.crdate.toString().slice(0,10)}</h2>
    
    </div>
    <div>
        <h3>By {frontmatter.author}</h3>
    </div>
    <div class="postbody">
    <slot/>
    </div>
    
</Master>