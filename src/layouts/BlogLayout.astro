---
import '/src/styles/global.css'
import Master from './Master.astro'
const {frontmatter} = Astro.props;

---
<style>
    div{
        display:flex;
        justify-content:center;
        gap:4rem;
    }
    .postbody{
        display:block;
        justify-content:left;
        margin:3rem;
    }
    

</style>
<style is:global>
    p{
        max-width:100ch;
        margin:2rem auto;
    }
    img{
        max-width:500px;
        
    }
</style>
<Master title={frontmatter.title}>
    <div>
    <h2>Published: {frontmatter.crdate.toString().slice(0,10)}</h2>
    </div>
    <div class="postbody">
    <slot style="p{dislpay:block;margin-top:1rem;}"/>
    </div>
    
</Master>