---
import Project from "./Project.astro";
const projList = await Astro.glob('/src/others-projects/*.md');
---
<style>
    div{
        display:flex;
        flex-wrap:wrap;
        gap:1.25rem;
        justify-content:center;
        max-width:230ch;
        margin:2rem auto;
    }
</style>
<div>
    {projList.map((project) => <Project frontmatter={project.frontmatter} textbody={project}/>)}
</div>