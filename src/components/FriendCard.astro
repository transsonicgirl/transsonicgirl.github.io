---
import '../styles/global.css'
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
const { frontmatter, textbody} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata}>('/src/images/*.{jpeg,jpg,png,gif}')
---
<style>
    .friend{
        display:inline-flex;
        background-color:#292941;
        color: #d7acec;
        padding:1.5rem 1.5rem;
        border-radius: 2rem;
        text-decoration:none;
    }
    
    .friend:visited{
        background-color:#292941;
        border:#b8b8d4;
        color: #d7acec;
    }
    .friend:hover{
        background-color:#4f4f64;
        color:rgb(159, 82, 231);
    }
    .friendheader{
        justify-self:center;
        display:flex;
        padding:0.5rem 0.25rem;
    }
    .friendheader h1{
        display:inline-flex;
        align-self:center;
    }
    .friendheader img{
        display:inline-flex;
        margin:0rem 1rem;
    }
    @media screen and (max-width:635px){
        .friendheader img{
            display:none;
        }
        
    }
    .friendbody{
        display:block;
        text-wrap:wrap;
        max-width:40ch;
    }
</style>

<a class="friend" href={frontmatter.fren_url}>
    <div class="friendbody">
        <h1>{frontmatter.title}</h1>
        {textbody.rawContent()}
        
    </div>
    <div class="friendheader">
        <Image src={images[frontmatter.img_url]()} alt="" width="150"/>
    </div>
</a>
