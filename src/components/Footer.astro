---
import Social from "./Social.astro";
---
<style>
    footer{
        display:flex; 
        gap:2rem;
        margin:0;
        margin-bottom:0;
        background-color:#42416e;
        position:fixed;
        bottom:0;
        width:100%;
        left:0;
        justify-content:center;
        align-content:center;

    }
    p{
        display:flex;
        gap:2rem;
        margin:0 0;
        justify-content:center;
        align-content:center;
    }
    h1{
        align-self:center;
    }
    @media screen and (max-width:635px){
        p{
            justify-self:center;
            justify-content:center;
        }
        h1{
            display:none;
        }
    }
</style>
<footer>
    <h1>Socials:</h1>
    <p>
        
        <Social url="https://www.github.com/transsonicgirl" site="Github" />
        <Social url="https://www.twitter.com/transsonicgirl" site="Twitter" />
        <Social url="mailto:allison.byrnes42@gmail.com" site="Email" />
    </p>
</footer>